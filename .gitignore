# Secrets — NEVER commit. Only .env.example belongs in git.
.env

# Everything else under outputs/ IS committed, including the review dashboard and the
# rendered report: this repository is private, and a reviewer should be able to open the
# artifacts without rebuilding them.

# Machine-local only: these are not artifacts, and committing them would either bloat the
# history or break on another machine. Say the word if any of them should go in too.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.log
.DS_Store
# 239 MB of downloaded source datasets; the curated 60 documents live in data/docs/.
data/raw/
# Cached model responses, rewritten on every run.
.cache/
# Per-machine agent settings. The shared skill in .claude/skills/ IS committed.
.claude/settings.local.json
