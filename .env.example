# Copy to .env and fill in. Never commit the real .env.
# Any OpenAI-compatible endpoint works. Gemini exposes one at the /openai/ path,
# so the same Provider class serves both models unchanged.
#
# Architecture: Option 1 -- VLM reader + text-LLM reasoner.
#   Model A (VLM)  : image -> {transcription, fields}   [hosted: no CPU cost]
#   Model B (LLM)  : transcription -> fields            [hosted: text-only, cheap]
#   Validation     : pure Python, model-free, instant
# Nothing runs on the local CPU except downscaling, validation and metrics.
# Rationale: CPU-only vision/LLM inference is impractically slow (a 3B model
# generating ~600 tokens of JSON on CPU is ~40-90s/doc). Hosted keeps it ~3-8s/doc.

# Local endpoints (Ollama, vLLM, a stub): use 127.0.0.1, not localhost. On Windows the
# client tries IPv6 localhost first and falls back after ~4s PER CALL, which silently
# inflates every latency number in the scorecard (measured: 3.96s vs 0.21s).
# UNDER DOCKER, 127.0.0.1 is the container itself: point a host-local model at
# http://host.docker.internal:<port> instead. Hosted endpoints need no change.

# --- Model A: VLM reader (image -> transcription + fields) ---
# Google AI Studio free tier, no credit card. MEASURED 2026-09-18 on gemini-3.6-flash:
# the daily cap is 20 requests PER MODEL PER DAY, not the 250 RPD older docs quote
# (429 RESOURCE_EXHAUSTED, quotaId GenerateRequestsPerDayPerProjectPerModel-FreeTier).
# That is ~20 documents/day for the VLM, so a 39-document test split does NOT fit in one
# day on one free key. Plan around it: the cache makes a re-run of the same documents
# free, and the cascade model has its own separate daily quota.
VLM_A_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# gemini-2.5-flash is no longer available to new accounts (404). Verified working
# 2026-09-17: gemini-3.6-flash. Pin a version; "gemini-flash-latest" moves silently and
# breaks run-to-run comparability.
VLM_A_MODEL=gemini-3.6-flash
VLM_A_API_KEY=

# --- Model B: text LLM reasoner (transcription -> fields) ---
# DIFFERENT FAMILY on purpose: siblings (e.g. Flash + Flash-Lite) fail the same way
# on the same smudged digit, which inflates the agreement signal exactly where it
# needs to be honest. Free slugs rotate -- check openrouter.ai/models?fmt=free;
# "openrouter/free" is an auto-routing fallback that survives slug churn.
LLM_B_BASE_URL=https://openrouter.ai/api/v1
# qwen/qwen-2.5-7b-instruct:free has been removed. Trial on 2026-09-17 (a real receipt
# re-extraction): nvidia/nemotron-3-super-120b-a12b:free returned valid, reconciling JSON
# (~18-22s); glm-5.2 and laguna-s-2.1 were rate-limited (429), nemotron-3.5-lightning
# returned empty output, inkling-small refused. Gemma is excluded: same family as Model A.
LLM_B_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_B_API_KEY=

# --- Phase 6 cascade base (cheap first pass, escalate on low confidence) ---
# 15 RPM / 1000 RPD -- highest free quota, so it absorbs the bulk of the volume.
# BASE_URL / API_KEY fall back to Model A's when unset (same provider).
CASCADE_MODEL=gemini-3.5-flash-lite
CASCADE_BASE_URL=
CASCADE_API_KEY=
# Escalate when a PRESENT field scores below this. Defaults to CONFIDENCE_THRESHOLD.
# Tune it on the calibration split and read the choice off the before/after table.
CASCADE_ESCALATE_BELOW=
# pipeline = always two models | cascade = cheap first, escalate on doubt (API + batch)
EXTRACTION_MODE=pipeline

# --- Abstention ---
# Do NOT hand-pick this. Read it off the risk-coverage curve against a target
# precision, fitted on a held-out calibration split. See extractor/confidence.py.
# Fitted on this dataset 2026-09-18 (18 calibration receipts, 198 field observations):
# 0.875 keeps 70.7% of fields at 95.0% precision. Refit after any change to the models,
# the prompts or the labels - the number belongs to that configuration, not to the code.
CONFIDENCE_THRESHOLD=0.875
CONFIDENCE_MODEL_PATH=.cache/confidence_model.json

# --- Cost accounting (Phase 5) ---
# USD per 1M tokens, used to report a LIST-PRICE EQUIVALENT $/doc. Free tiers cost $0
# in practice; these make the Phase 6 optimization measurable. Verify against the
# providers' current pricing pages before quoting numbers — prices change.
VLM_A_PRICE_IN_PER_M=0.30
VLM_A_PRICE_OUT_PER_M=2.50
LLM_B_PRICE_IN_PER_M=0.04
LLM_B_PRICE_OUT_PER_M=0.10
CASCADE_PRICE_IN_PER_M=0.10
CASCADE_PRICE_OUT_PER_M=0.40

# --- Serving / batch (Phase 5) ---
# Bounded concurrency: at ~10 RPM, fanning out wider only turns into 429 retries.
API_MAX_CONCURRENCY=3
BATCH_CONCURRENCY=3
MAX_UPLOAD_MB=20
MAX_BATCH_FILES=20
# eval.run --source api target. docker-compose sets http://api:8000 for the eval service.
EVAL_API_URL=http://127.0.0.1:8000
EVAL_API_TIMEOUT_S=600
# Output budgets. Gemini 2.5 is a THINKING model: its reasoning tokens come out of the
# same max_tokens, so a small budget truncates the JSON on long receipts. A truncated
# response now fails loudly (TruncatedResponse) instead of as a JSON parse error.
VLM_MAX_TOKENS=8192
VLM_MAX_TOKENS_PER_EXTRA_PAGE=4096
LLM_MAX_TOKENS=4096
# Multi-page PDFs are read in full; longer documents are refused, never truncated.
MAX_PAGES=5
PROVIDER_MAX_RETRIES=5
PROVIDER_TIMEOUT_S=120
LOG_LEVEL=INFO

# --- Caching (critical for a fast dev loop) ---
# Keyed by image hash: re-running eval after a metrics/taxonomy change costs ZERO
# API calls and ~1 second.
CACHE_DIR=.cache/extractions
